{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/README.md",
    "docs/API.md",
    "docs/ARCHITECTURE.md",
    "mcp-server/README.md",
    "mcp-server/manual_md/README.md"
  ],
  "mcp": {
    "contpaqi-bridge": {
      "type": "local",
      "command": ["node", "mcp-server/server.js"],
      "enabled": true,
      "environment": {
        "CONTPAQI_BRIDGE_URL": "http://localhost:5000",
        "CONTPAQI_API_KEY": "REEMPLAZA_CON_TU_API_KEY_DEL_BRIDGE"
      },
      "description": "MCP server que expone el ContpaqiBridge (.NET) y el Manual de Referencia del SDK como herramientas y recursos para asistentes IA."
    }
  }
}